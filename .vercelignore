# Vercel should only serve the pre-built output/ folder and the /api
# serverless functions. These other Python files are what GENERATE the
# site (run locally or by the GitHub Actions workflow) — Vercel doesn't
# need to see them, and without this file it mistakes main.py for a
# serverless function.

*.py
!api/*.py
__pycache__/
templates/
.github/
requirements.txt
README.md
supabase/
